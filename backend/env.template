# StyleMate configuration.
#
# This file is read at startup by backend/app/config.py and by
# start_stylemate.command. The non-secret half is published to the page at
# /api/config, so the model names and context size live HERE and nowhere else.
#
# A value already set in your shell wins over this file.
# Never commit a real key. Copy this file, do not share it.

# ---- Google Gemini -------------------------------------------------------
# Created as requested. Empty for now, which is a valid state: with no key the
# provider falls back to the local Ollama, which is what SM_PROVIDER=auto does.
# The key stays on the backend. It is never sent to the browser and is not
# included in /api/config.
GEMINI_API_KEY=

# Model ids verified against https://ai.google.dev/gemini-api/docs/models on
# 28 Oct 2026. Both of these are listed with image input on the pricing page,
# so the same pair covers search, skin tone and garment description.
#
# Text: cheapest current-generation model that still reasons, and the only one
# that DEFAULTS to minimal thinking - reasoning becomes opt-in, not billed by
# default. $0.25 in / $1.50 out per 1M tokens.
SM_GEMINI_TEXT_MODEL=gemini-3.1-flash-lite

# Vision: one call per photo, so a slightly better model costs almost nothing
# here. $0.30 in / $2.50 out per 1M tokens.
SM_GEMINI_VISION_MODEL=gemini-3.5-flash-lite

SM_GEMINI_EMBED_MODEL=gemini-embedding-001

# Step up if Flash-Lite is not accurate enough on your own queries:
#   SM_GEMINI_TEXT_MODEL=gemini-3.8-flash      $0.75/$3.75, doubles 1 Jan 2027
# Do not point these at gemini-4-argon per search: $2/$10, doubling 1 Dec 2026.

# ---- Which model does the thinking --------------------------------------
# auto   = Gemini when a key is present, otherwise the local Ollama
# gemini = always Gemini
# ollama = always the local model
# 'auto' is the safe setting: add the key and it switches to Gemini; remove the
# key and it falls back to Ollama rather than failing.
SM_PROVIDER=auto

# ---- Local Ollama --------------------------------------------------------
SM_OLLAMA_HOST=http://localhost:11434
SM_TEXT_MODEL=qwen2.5:7b

# qwen3-vl:8b is the one pulled and working here. The project's own example
# names qwen2.5vl:7b, which also works — change this line, not the code.
SM_VISION_MODEL=qwen3-vl:8b

# Ollama accepts a prompt of at most HALF of num_ctx and silently truncates
# past that, keeping only the tail. 32768 leaves ~16k of usable prompt.
SM_NUM_CTX=32768

# Seconds. A cold model load plus a long prefill can exceed the 180 default.
SM_LLM_TIMEOUT=300

# ---- Retrieval and storage ----------------------------------------------
SM_RESULTS=24
SM_SHORTLIST=60
SM_DATA_DIR=./var
SM_CORS=*

# ---- Audit log sink ------------------------------------------------------
# serve_with_logs.js / .py listens here and writes logs/<file>.json.
SM_LOG_SINK=http://localhost:8765/log
