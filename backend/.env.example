# Copy to .env and edit, or set these in your shell before launching.
# Every value has a working default; nothing here is required.

# ---- Which model does the thinking --------------------------------------
# auto   = Gemini when a key is present, otherwise local Ollama
# gemini = always Google Gemini
# ollama = always the local model
SM_PROVIDER=auto

# ---- Google Gemini -------------------------------------------------------
# You can also paste the key into the app under Agent model, which keeps it
# in server memory only and never writes it to disk.
GEMINI_API_KEY=
SM_GEMINI_TEXT_MODEL=gemini-2.5-flash
SM_GEMINI_VISION_MODEL=gemini-2.5-flash
SM_GEMINI_EMBED_MODEL=gemini-embedding-001

# ---- Local Ollama --------------------------------------------------------
SM_OLLAMA_HOST=http://localhost:11434
SM_TEXT_MODEL=qwen2.5:7b
SM_VISION_MODEL=qwen2.5vl:7b
SM_NUM_CTX=16384
SM_LLM_TIMEOUT=180

# ---- Storage and retrieval ----------------------------------------------
SM_DATA_DIR=./var
SM_RESULTS=24
SM_CORS=*
